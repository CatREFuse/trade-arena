OPS_ENV=prod
WEBHOOK_PORT=9000

# 用于 GitHub Webhook 签名校验
WEBHOOK_SECRET=replace_with_strong_secret

# 用于 /ops/* 接口鉴权（Authorization: Bearer <OPS_API_KEY>）
OPS_API_KEY=replace_with_strong_secret

# 允许部署的分支，空格或逗号分隔
OPS_ALLOWED_BRANCHES=main

# 可选：美股备用行情源 API Key（建议至少配置 Twelve Data）
# MARKET_TWELVEDATA_API_KEY=
# MARKET_ALPHAVANTAGE_API_KEY=
# MARKET_FINNHUB_API_KEY=
# MARKET_TUSHARE_TOKEN=

# 可按需覆盖日志与运行目录
# OPS_RUNTIME_DIR=/etc/nginx/website/trade-arena/.runtime/ops
# OPS_DEPLOY_LOG=/var/log/trade-arena-deploy.log
